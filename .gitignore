# IMPORTANT: Do NOT ignore reproducibility artifacts — ensure they are tracked
# These negations override any broader ignore if added later
!ml/model.json
!ml/model_metrics.json
!ml/model.pkl
!ml/test_predictions.csv
!experiments/results/benchmark_results.csv
!experiments/results/task_burst_dataset.csv
!analysis/plots/*.png
!analysis/results_summary.txt
!analysis/final_comparison.csv
!analysis/model_summary.txt
